# W&S Operaciones - entorno VPS/Docker
# Copiar a .env en el servidor y completar valores reales. No subir .env a git.

NODE_ENV=production
PORT=3000

# Dominio publico de la app. Ejemplo: https://app.wstextil.com
PUBLIC_HOST=app.tu-dominio.com
PUBLIC_URL=https://app.tu-dominio.com

# Puerto local de la app. En VPS se deja cerrado a localhost y Caddy publica HTTPS.
APP_BIND=127.0.0.1
APP_PORT=3000

# Freno inicial de migracion:
# 0 = no arrancar crones ni bots automaticos
# 1 = activar automatizaciones cuando ya este probado
CRONS_ENABLED=0

# 0 = no enviar WhatsApp/Telegram/documentos aunque alguien dispare acciones
# 1 = activar envios cuando Evolution/Telegram ya esten migrados
NOTIFICATIONS_ENABLED=0

# Limites para que el consumo no se dispare en VPS
APP_MEM_LIMIT=1536m
APP_CPUS=1.0
CADDY_MEM_LIMIT=128m
CADDY_CPUS=0.25

# Seguridad interna
API_KEY=cambiar-por-clave-larga
RESET_KEY=cambiar-por-clave-larga-distinta
EVOLUTION_WEBHOOK_TOKEN=cambiar-por-token-largo-webhook

# Evolution API: usar http://evolution-api:8080 si se levanta con el perfil evolution.
EVOLUTION_API_URL=http://evolution-api:8080
EVOLUTION_DB_URL=postgresql://evolution:cambiar-por-password-largo@evolution-postgres:5432/evolution
EVOLUTION_API_KEY=cambiar-por-api-key-evolution
WA_NOTIF_APIKEY=cambiar-por-api-key-evolution
WA_NOTIF_INSTANCE=ws-duvan
WA_GRUPO_TRABAJO=
EVO_KEY_VENTAS=
EVO_KEY_WENDY=
EVO_KEY_NEY=
EVO_KEY_PAOLA=

# Numeros WhatsApp por persona. Solo digitos, idealmente con 57.
WA_BETTY=
WA_NEY=
WA_WENDY=
WA_PAOLA=
WA_CAMILO=
WA_DUVAN=
WA_GRACIELA=
WA_LIDERMEYER=
WA_MARCELA=
WA_CRISTINA=
WA_WILSON=
WA_YAMILE=
WA_NICOL=
WA_OSCAR=

# Google/Gmail/Drive. El redirect debe coincidir con PUBLIC_URL.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://app.tu-dominio.com/api/gmail/callback

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_CHAT_ID_DUVAN=
TELEGRAM_CHAT_ID_ADMIN=

# Chatwoot, IA y Notion se dejan vacios hasta reactivar automatizaciones.
CHATWOOT_URL=
CHATWOOT_ACCOUNT_ID=
CHATWOOT_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6
NOTION_TOKEN=
NOTION_DB_ARCHIVO_PEDIDOS=

# Evolution self-hosted opcional
EVOLUTION_IMAGE=evoapicloud/evolution-api:v2.1.1
EVOLUTION_BIND=127.0.0.1
EVOLUTION_PORT=8080
EVOLUTION_SERVER_URL=https://app.tu-dominio.com
EVOLUTION_AUTHENTICATION_API_KEY=cambiar-por-api-key-evolution
EVOLUTION_POSTGRES_DB=evolution
EVOLUTION_POSTGRES_USER=evolution
EVOLUTION_POSTGRES_PASSWORD=cambiar-por-password-largo
EVOLUTION_MEM_LIMIT=1024m
EVOLUTION_CPUS=1.0
EVOLUTION_POSTGRES_MEM_LIMIT=768m
EVOLUTION_POSTGRES_CPUS=0.5
EVOLUTION_REDIS_MEM_LIMIT=256m
EVOLUTION_REDIS_CPUS=0.25
